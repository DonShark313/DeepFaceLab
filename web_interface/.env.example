# DeepFaceLab Web Interface Configuration
# Copy this file to .env and fill in your values

# Flask Settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# File Storage
UPLOAD_FOLDER=./uploads
OUTPUT_FOLDER=./output
MODELS_FOLDER=./models

# DeepFaceLab Settings
DEEPFACELAB_PATH=./
DEEPFACELAB_WORKSPACE=./workspace

# Video Processing
VIDEO_CODEC=libx264
VIDEO_QUALITY=23
VIDEO_FPS=30

# GPU Settings
USE_GPU=True
GPU_DEVICE_ID=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/deepfacelab_web.log

# Cleanup
AUTO_CLEANUP=True
CLEANUP_AGE_DAYS=7

# Maximum file size in MB
MAX_FILE_SIZE_MB=100
